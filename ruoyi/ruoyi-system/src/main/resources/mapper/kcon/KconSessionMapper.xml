<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.kcon.mapper.KconSessionMapper">

    <resultMap type="KconSession" id="KconSessionResult">
        <id     property="id"     column="id"     />
        <result property="code"   column="code"   />
        <result property="name"   column="name"   />
        <result property="status" column="status" />
        <result property="sort"   column="sort"   />
    </resultMap>

    <select id="selectSessionList" resultMap="KconSessionResult">
        select id, code, name, status, sort from kcon_session order by sort asc, id asc
    </select>

    <select id="selectByCode" parameterType="String" resultMap="KconSessionResult">
        select id, code, name, status, sort from kcon_session where code = #{code} limit 1
    </select>

    <update id="activate" parameterType="String">
        update kcon_session
        set status = case when code = #{code} then 1 else 0 end
    </update>

</mapper>
