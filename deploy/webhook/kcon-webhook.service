[Unit]
Description=KCon Gitee tag deploy webhook
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/webhook -hooks /etc/kcon/hooks.json -port 9000 -interface 0.0.0.0
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
