# =============================================================
# KConLucky .gitignore
# =============================================================

# ---- 依赖与构建产物 ----
node_modules/
dist/
target/
*.class
*.jar
*.war

# ---- Maven 本地缓存 ----
# 容器构建时挂载进来加速依赖下载，体积 100MB+，不需要进版本库
.m2cache/
.mvn/

# ---- 运行时数据（绝对不能进版本库）----
# data/ 里有 MySQL 数据文件、Redis dump、上传文件，体积 200MB+，
# 且属于现场数据。迁移时随项目目录整体拷贝即可，不进代码仓库。
#
# 必须写成 /data/ 而不是 data/：gitignore 规则匹配「任意层级」的同名目录，
# 写成 data/ 会连源码目录 ruoyi-ui/src/views/kcon/data/（数据管理页）一起排除，
# 导致该页面从未入库。新克隆的仓库缺这个文件，前端动态 import 报
# "Cannot find module './kcon/data/index'"，点击菜单无反应且控制台报错。
/data/
/logs/
*.log

# ---- 密钥与本地配置 ----
# .env 里有 MYSQL_ROOT_PASSWORD / TOKEN_SECRET 等真实密钥，不入库。
# 新机器部署按 docs/04-部署运行.md 说明，从 .env.example 复制并生成密钥。
.env
.env.local
.env.*.local

# 证书与私钥（MySQL 自签证书等）
*.pem
*.key
*.p12
*.jks

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# ---- AI 编码助手本地数据 ----
# .codebuddy/ 是 CodeBuddy IDE 的本地工作数据（含会话、索引、本地偏好），
# 属于「本机状态」而非团队资产，不入版本库。
# 注意：spec-kit 生成的 slash 命令正是落在 .codebuddy/commands/，
# 该目录同样不入库；团队成员各自用 `specify init` 就地生成即可（见
# .specify/README 说明）。
.codebuddy/

# ---- 临时文件 ----
*.tmp
*.bak
*.orig
# playwright-cli 会话快照（本地调试产物，不入库）
.playwright-cli/
