# =============================================================
# KConLucky .gitignore
# =============================================================

# ---- 依赖与构建产物 ----
node_modules/
dist/
target/
*.class
*.jar
*.war

# ---- Maven 本地缓存 ----
# 容器构建时挂载进来加速依赖下载，体积 100MB+，不需要进版本库
.m2cache/
.mvn/

# ---- 运行时数据（绝对不能进版本库）----
# data/ 里有 MySQL 数据文件、Redis dump、上传文件，体积 200MB+，
# 且属于现场数据。迁移时随项目目录整体拷贝即可，不进代码仓库。
#
# 必须写成 /data/ 而不是 data/：gitignore 规则匹配「任意层级」的同名目录，
# 写成 data/ 会连源码目录 ruoyi-ui/src/views/kcon/data/（数据管理页）一起排除，
# 导致该页面从未入库。新克隆的仓库缺这个文件，前端动态 import 报
# "Cannot find module './kcon/data/index'"，点击菜单无反应且控制台报错。
/data/
/logs/
*.log

# ---- 密钥与本地配置 ----
# .env* 里有 MYSQL_ROOT_PASSWORD / TOKEN_SECRET 等真实密钥，一律不入库
# （含 .env.release 这类发行版副本，漏忽略会误提交密钥）。
# 只放行两个模板：.env.example / .env.release.example（不含真实密钥）。
# 新机器部署按 docs/04-部署运行.md 说明，从模板复制并生成密钥。
.env
.env.*
!.env.example
!.env.release.example

# 证书与私钥（MySQL 自签证书等）
*.pem
*.key
*.p12
*.jks

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# ---- AI 编码助手本地数据 ----
# .trae/ 是 Trae IDE 的本地工作数据：spec-kit 生成的 skills 落在
# .trae/skills/speckit-*/，属于「本机状态」而非团队资产，不入版本库。
# 团队成员各自用 `specify integration install trae` 就地生成（见 .specify/README）。
.trae/
# .codebuddy/ 为 CodeBuddy IDE 的本地工作数据（历史集成，当前项目已切换到 Trae）。
.codebuddy/
# .serena/ 是 Serena MCP 代码分析工具的本地配置（project.yml 含绝对路径），
# 同样属「本机状态」：换台机器路径就不同，入库只会制造无意义冲突。
.serena/

# ---- 临时文件 ----
*.tmp
*.bak
*.orig
# playwright-cli 会话快照（本地调试产物，不入库）
.playwright-cli/

# ---- 参考资料 ----
# 原始交付包（kcon-prod.zip）、需求文档、演示名单等：
# 体积大、非代码资产，且含参会人样例数据，不入版本库。
参考文件/
