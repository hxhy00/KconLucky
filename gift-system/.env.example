# 赠票系统部署配置（复制为 .env 后填写，不要提交真实值）
# 对外访问地址（含端口），决定页面与邮件里的链接
KCON_GIFT_SITE_URL=http://123.57.9.62:8848

# 初始管理员（admin 表为空时写入），≤3 个，逗号分隔，支持 email 或 email:姓名
KCON_ADMIN_EMAILS=ops@example.com:运营负责人

# 发件人（邮件出箱模式下仅作展示）
KCON_SYSTEM_EMAIL=kcon@knownsec.com

# 生产必须为 0（禁止回显验证码）；仅本地 Demo 才设 1
KCON_DEMO_CODE=0

# 二期真实发信（企业微信邮 / 腾讯企业邮）；留空则只落出箱
# KCON_SMTP_HOST=smtp.exmail.qq.com
# KCON_SMTP_PORT=465
# KCON_SMTP_USER=kcon@knownsec.com
# KCON_SMTP_PASSWORD=授权码
