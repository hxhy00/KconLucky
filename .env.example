# =============================================================
# KCon 2026 签到 + 抽奖系统 · 配置模板
#
# 使用方式：
#   cp .env.example .env
#   然后按下面说明填写。.env 含真实密钥，不要提交到 git
# 详见 docs/04-部署运行.md 第 4 节
# =============================================================

# ---- 对外端口 ----
WEB_PORT=80                 # 三端统一入口；80 冲突时改 8081 等
MYSQL_DEBUG_PORT=3307       # 仅本机调试用，已强制绑定 127.0.0.1

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=改成你自己的强口令
MYSQL_DATABASE=kcon_lucky

# ---- 后端 ----
BACKEND_PORT=8080
TZ=Asia/Shanghai

# ---- 令牌密钥（必填）----
# JWT 签名密钥，必须 32 字节以上随机串，不能用若依开源默认值，
# 否则后端启动会直接拒绝（这是刻意的安全校验）。
# 生成方式：openssl rand -base64 48
TOKEN_SECRET=用_openssl_rand_生成后填入

# ---- 现场信息（用于生成签到二维码与展示地址）----
# 第一期 内网单机：填本机局域网 IP，如 192.168.1.100
# 第二期 公网部署：填对外域名或公网 IP，观众无需与服务器同网络
LAN_IP=192.168.1.100

# ---- 统一前缀（web 容器 nginx 反代路径）----
# 部署在 https://www.knownsec.com/kconluck2026/ 时填 /kconluck2026
# 注意：该项只影响运维脚本探测路径；nginx 的前缀在镜像构建期固定，
# 预构建镜像固定为 /kconluck2026/，换前缀需用
#   docker build --build-arg DEPLOY_PREFIX=新前缀 -f docker/web/Dockerfile
# 重新构建（详见 docs/04-部署运行.md §17.3）
KCON_BASE_PATH=
