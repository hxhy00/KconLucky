# =============================================================
# KCon 2026 签到 + 抽奖系统 · 发行版配置模板
#
# 使用方式：
#   cp .env.release.example .env
#   必须修改：MYSQL_ROOT_PASSWORD、TOKEN_SECRET、LAN_IP
#   然后：docker compose -f docker-compose.release.yml up -d
#
# .env 含真实密钥，不要提交到 git。
# 完整说明见 docs/04-部署运行.md 第 17.5 节。
#
# 首次启动后管理端初始账号（请立即修改口令）：
#   账号 13000000000  口令 Kcon2026Aa.
# =============================================================

# ---- 对外端口 ----
WEB_PORT=80                 # 三端统一入口；80 被占用时改成 8081 等

# ---- 数据库（必填）----
# 首次启动时据此初始化数据卷；改这里不会影响已初始化的库
MYSQL_ROOT_PASSWORD=改成你自己的强口令
MYSQL_DATABASE=kcon_lucky

# ---- 令牌密钥（必填）----
# JWT 签名密钥，必须 32 字节以上随机串，不能用若依开源默认值，
# 后端启动时会校验，不达标直接拒绝启动。
# 生成方式：openssl rand -base64 48
TOKEN_SECRET=用_openssl_rand_生成后填入

# ---- 对外访问地址（必填）----
# 用于生成签到二维码，填服务器 IP 或域名。观众扫码直接看到该地址。
LAN_IP=192.168.1.100

# ---- 域名 + HTTPS 部署（可选，填了优先于 LAN_IP）----
# 二维码要带 https 时填完整基地址，不要结尾斜杠：
# PUBLIC_BASE_URL=https://kcon-luck.knownsec.com
PUBLIC_BASE_URL=

# ---- 镜像版本 ----
# 默认 v0.2.3；也可用 sha-<短SHA> 精确锁定某次构建，或用 edge 跟随 main 最新
KCON_TAG=v0.2.3
# 私有化部署到自己的镜像仓库时改这里（不含镜像名后缀）
# KCON_REGISTRY=registry.example.com/kcon

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 后端 JVM（可选，内存紧张时下调）----
# JAVA_OPTS=-Xms256m -Xmx512m -Xss512k -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError
